<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Windows resolves the narrow Win32 and CRT entry points through the process
  "ANSI" code page, which is a regional legacy encoding by default. Every path
  the framework carries is UTF-8, so without this the compiler cannot open a
  source file whose name is not pure ASCII, and non-ASCII text crossing a
  narrow API is silently mangled rather than rejected.

  Declaring UTF-8 as the active code page makes the narrow entry points agree
  with the rest of the framework instead of forcing a wide-character port of
  every call site. Needs Windows 10 1903 or newer.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage
          xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
