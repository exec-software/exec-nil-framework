!!! =============================================================================
!!! sdkinstaller — Environment variable management
!!! =============================================================================
!!!
!!! Compute and write the environment configuration for an installed SDK.
!!! This produces:
!!!
!!! - A shell-sourceable `nil.env` file containing export statements.
!!! - An `sdkinstaller-state.nildata` manifest recording what was installed.
!!!
!!! The environment entries are derived from EnvHook components and the
!!! install location.

book sdkinstaller.envsetup

read everything from sdkinstaller.config
read everything from sdkinstaller.workloads
read nil.std.io


!!! --- Compute the environment entries for an installed SDK.
!!!
!!! Takes the resolved components and the install path, and returns a list
!!! of EnvEntry records. Three kinds are produced:
!!!
!!! 1. EnvHook components that prepend a subdirectory of the SDK to a
!!!    PATH-like variable (e.g. PATH += bin/).
!!! 2. EnvHook components that set a variable to the SDK path itself
!!!    (envValue is "<sdk-path>").
!!! 3. Framework components that declare an envVar (e.g. NIL_UI_GTK_DIRECTORY).

public compute-env-entries receives components as array of Component, installPath as text returns array of EnvEntry begin paragraph
    variable entries as array of EnvEntry is []

    variable ci as number is 0
    repeat for ci from 0 to (the length of components)
        value comp is components at ci

        consider comp . kind
            when ComponentKind.EnvHook then begin block
                when (the length of comp . envVar) equals 0 then
                    !!! Skip malformed env-hook components.
                otherwise when (the length of comp . prependPath) greater-than 0 then
                    !!! Prepend a subdirectory of the SDK to a PATH-like variable.
                    value prependValue is installPath plus "/" plus comp . prependPath
                    set entries to entries + [build EnvEntry with
                        name being comp . envVar,
                        value being "",
                        prependPath being prependValue]
                otherwise when comp . envValue equals "<sdk-path>" then
                    !!! Set a variable to the SDK path itself.
                    set entries to entries + [build EnvEntry with
                        name being comp . envVar,
                        value being installPath,
                        prependPath being ""]
                otherwise when (the length of comp . envValue) greater-than 0 then
                    set entries to entries + [build EnvEntry with
                        name being comp . envVar,
                        value being comp . envValue,
                        prependPath being ""]
                end when
            end block
            when ComponentKind.FrameworkFiles then begin block
                !!! Framework components that declare an envVar get an entry too.
                when (the length of comp . envVar) greater-than 0 then
                    when (the length of comp . prependPath) greater-than 0 then
                        set entries to entries + [build EnvEntry with
                            name being comp . envVar,
                            value being "",
                            prependPath being installPath plus "/" plus comp . prependPath]
                    otherwise
                        set entries to entries + [build EnvEntry with
                            name being comp . envVar,
                            value being installPath plus "/" plus comp . sourcePath,
                            prependPath being ""]
                    end when
                end when
            end block
            otherwise
                !!! No env entries for SystemPackage or GeneratedTemplate.
        end consider
    end repeat

    give entries
end paragraph


!!! --- Render environment entries as shell export statements for POSIX.
!!!
!!! For PATH-like entries (prependPath is non-empty), the export prepends
!!! to the existing variable. For literal entries, it sets the variable.

public render-shell-env receives entries as array of EnvEntry returns text begin paragraph
    variable lines as array of text is [
        "# NIL SDK environment",
        "# Generated by sdkinstaller. Source this file in your shell:",
        "#   . /path/to/nil-sdk/nil.env"
    ]

    variable idx as number is 0
    repeat for idx from 0 to (the length of entries)
        value entry is entries at idx
        when (the length of entry . prependPath) greater-than 0 then
            set lines to lines + [
                "export " plus entry . name plus "=\"" plus entry . prependPath plus ":$" plus entry . name plus "\""
            ]
        otherwise when (the length of entry . value) greater-than 0 then
            set lines to lines + [
                "export " plus entry . name plus "=\"" plus entry . value plus "\""
            ]
        end when
    end repeat

    give join-lines with lines
end paragraph


!!! --- Join an array of text lines with newline separators.

public join-lines receives lines as array of text returns text begin paragraph
    variable result as text is ""
    variable idx as number is 0
    repeat for idx from 0 to (the length of lines)
        set result to result plus lines at idx
        when idx less-than (the length of lines minus 1) then
            set result to result plus "\n"
        end when
    end repeat
    give result
end paragraph


!!! --- Write the nil.env shell script to the install directory.
!!!
!!! Returns Result.Ok holding the file path on success, or Result.Error
!!! holding an error message if the file could not be written.

public write-env-file receives entries as array of EnvEntry, installPath as text returns Result of text, text begin paragraph
    value content is render-shell-env with entries
    value envPath is installPath plus "/nil.env"
    value wrote is write-text-file at envPath, content
    consider wrote
        when Result.Ok holding _ then
            give Result.Ok holding envPath
        when Result.Error holding err then
            give Result.Error holding "could not write nil.env: " plus err
    end consider
end paragraph


!!! --- Write the install manifest as an nildata file.
!!!
!!! The manifest records what was installed so subsequent runs can repair
!!! or modify the installation.

public write-manifest receives state as InstallState, installPath as text returns Result of text, text begin paragraph
    value manifestPath is installPath plus "/sdkinstaller-state.nildata"
    value content is render-state-nildata with state
    value wrote is write-text-file at manifestPath, content
    consider wrote
        when Result.Ok holding _ then
            give Result.Ok holding manifestPath
        when Result.Error holding err then
            give Result.Error holding "could not write install manifest: " plus err
    end consider
end paragraph


!!! --- Render an InstallState record as an nildata document.

public render-state-nildata receives state as InstallState returns text begin paragraph
    variable lines as array of text is [
        "nildata 1",
        "object",
        "  schema is \"nil.install-state.v1\"",
        "  sdkPath is \"" plus state . sdkPath plus "\"",
        "  sdkVersion is \"" plus state . sdkVersion plus "\"",
        "  installedAt is \"" plus state . installedAt plus "\""
    ]

    set lines to lines + ["  installedComponentIds is an array"]
    variable idx as number is 0
    repeat for idx from 0 to (the length of state . installedComponentIds)
        set lines to lines + ["    item is \"" plus state . installedComponentIds at idx plus "\""]
    end repeat
    set lines to lines + ["  end array"]
    set lines to lines + ["end object"]

    give join-lines with lines
end paragraph


!!! --- Collect the list of component IDs from a component array.

public collect-component-ids receives components as array of Component returns array of text begin paragraph
    variable ids as array of text is []
    variable idx as number is 0
    repeat for idx from 0 to (the length of components)
        set ids to ids + [components at idx . id]
    end repeat
    give ids
end paragraph
