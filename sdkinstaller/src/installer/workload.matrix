        build Component with
            id being "docs.tutorials",
            name being "Tutorials",
            description being "Step-by-step tutorials for getting started.",
            kind being ComponentKind.FrameworkFiles,
            sizeBytes being 524288,
            dependencies being [],
            sourcePath being "docs/tutorials/",
            envVar being "",
