            kind being ComponentKind.FrameworkFiles,
            sizeBytes being 32768,
            dependencies being ["core.nilstd"],
            sourcePath being "docs/standard-library/ui.md",
            envVar being "",
            envValue being "",
            templatePath being "",

        !!! --- Security research extras ---
        build Component with
            id being "security.scanner",
            name being "Security scanner",
            description being "Static analysis and dependency audit tools.",
            kind being ComponentKind.FrameworkFiles,
            sizeBytes being 1048576,
            dependencies being ["core.nilbuild"],
