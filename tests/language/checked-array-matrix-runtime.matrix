!!! Exercise the same Matrix-authored collection functions from Matrix.
!!! Expected snapshots are independent of the implementation's loops.
book validation.checked_arrays

read everything from ny.lang.collections
read everything from ny.lang.core

require receives passed as boolean, label as text returns nothing begin paragraph
    evaluate assert-true with condition being passed, message being label
end paragraph

same-items of type T receives actual as array of T, expected as array of T, label as text returns nothing begin paragraph
    evaluate require with passed being ((the length of actual) equals (the length of expected)), label being label
    variable index as override integer is 0
    repeat while index is less than (the length of actual)
        evaluate require with passed being ((actual at index) equals (expected at index)), label being label
        set index to index plus 1
    end repeat
end paragraph

check-kind of type T receives first as T, second as T, third as T, label as text returns nothing begin paragraph
    value data as array of T is [first, second, third, first]
    value alias is data
    value original as array of T is [first, second, third, first]
    value minimum as override integer is minus 2147483647 minus 1
    value first-result is try-get of T with items being data, index being 0
    value second-result is try-get of T with items being data, index being 1
    value last-result is try-get of T with items being data, index being 3
    evaluate require with passed being ((first-result.unwrap with nothing) equals first), label being "get first"
    evaluate require with passed being (second-result.is-some with nothing), label being "zero and false are present"
    evaluate require with passed being ((second-result.unwrap with nothing) equals second), label being "get second"
    evaluate require with passed being ((last-result.unwrap with nothing) equals first), label being "get last"
    value missing-a is try-get of T with items being data, index being minus 1
    evaluate require with passed being (missing-a.is-none with nothing), label being "get rejects bounds"
    value missing-b is try-get of T with items being data, index being 4
    evaluate require with passed being (missing-b.is-none with nothing), label being "get rejects bounds"
    value missing-c is try-get of T with items being data, index being 2147483647
    evaluate require with passed being (missing-c.is-none with nothing), label being "get rejects bounds"
    value missing-d is try-get of T with items being data, index being minimum
    evaluate require with passed being (missing-d.is-none with nothing), label being "get rejects bounds"
    evaluate require with passed being ((try-set of T with items being data, index being minus 1, item-value being third) equals false), label being "set rejects bounds"
    evaluate same-items of T with actual being alias, expected being original, label being "rejected set preserves alias"
    evaluate require with passed being ((try-set of T with items being data, index being 4, item-value being third) equals false), label being "set rejects bounds"
    evaluate same-items of T with actual being alias, expected being original, label being "rejected set preserves alias"
    evaluate require with passed being ((try-set of T with items being data, index being 2147483647, item-value being third) equals false), label being "set rejects bounds"
    evaluate same-items of T with actual being alias, expected being original, label being "rejected set preserves alias"
    evaluate require with passed being ((try-set of T with items being data, index being minimum, item-value being third) equals false), label being "set rejects bounds"
    evaluate same-items of T with actual being alias, expected being original, label being "rejected set preserves alias"
    evaluate require with passed being (try-set of T with items being data, index being 1, item-value being third), label being "set valid"
    evaluate same-items of T with actual being alias, expected being [first, third, third, first], label being "set aliases and guards"
    evaluate require with passed being (try-fill-range of T with items being data, offset being 1, count being 2, item-value being second), label being "fill valid"
    evaluate same-items of T with actual being alias, expected being [first, second, second, first], label being "fill guards"
    evaluate require with passed being (try-copy-range of T with source being original, source-offset being 0, destination being data, destination-offset being 0, count being 4), label being "reset copy"
    evaluate require with passed being ((try-fill-range of T with items being data, offset being minus 1, count being 0, item-value being third) equals false), label being "fill rejects window"
    evaluate same-items of T with actual being alias, expected being original, label being "rejected fill preserves alias"
    evaluate require with passed being ((try-fill-range of T with items being data, offset being 0, count being minus 1, item-value being third) equals false), label being "fill rejects window"
