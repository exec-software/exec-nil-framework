module native_string_escape_parity

fn main() -> i32
    println("literal newline: \\n")
    println("literal tab: \\t")
    println("literal carriage return: \\r")
    println("literal NUL spelling: \\0")
    println("literal backslash: \\\\")
    println("quoted: \"ny\"")
    println("first\nsecond")
    return 0
end fn
