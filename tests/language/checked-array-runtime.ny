# Exercise the Matrix-authored collection functions from Ny. Expected values
# below are literal snapshots, independent of the implementation's loops.
import ny.lang.collections

fn require(passed: bool, label: text)
    if not passed then panic(label) end if
end fn

fn same_items<T>(actual: array<T>, expected: array<T>, label: text)
    require(actual.len() == expected.len(), label)
    let mut index: i32 = 0
    while index < actual.len()
        require(actual[index] == expected[index], label)
        index = index + 1
    end while
end fn

fn check_kind<T>(first: T, second: T, third: T, label: text)
    let data: array<T> = [first, second, third, first]
    let alias = data
    let original: array<T> = [first, second, third, first]
    let minimum: i32 = -2147483647 - 1
    require(try_get<T>(data, 0).unwrap() == first, "get first")
    require(try_get<T>(data, 1).is_some(), "zero and false are present")
    require(try_get<T>(data, 1).unwrap() == second, "get second")
    require(try_get<T>(data, 3).unwrap() == first, "get last")
    require(try_get<T>(data, -1).is_none(), "get rejects bounds")
    require(try_get<T>(data, 4).is_none(), "get rejects bounds")
    require(try_get<T>(data, 2147483647).is_none(), "get rejects bounds")
    require(try_get<T>(data, minimum).is_none(), "get rejects bounds")
    require(not try_set<T>(data, -1, third), "set rejects bounds")
    same_items<T>(alias, original, "rejected set preserves alias")
    require(not try_set<T>(data, 4, third), "set rejects bounds")
    same_items<T>(alias, original, "rejected set preserves alias")
    require(not try_set<T>(data, 2147483647, third), "set rejects bounds")
    same_items<T>(alias, original, "rejected set preserves alias")
    require(not try_set<T>(data, minimum, third), "set rejects bounds")
    same_items<T>(alias, original, "rejected set preserves alias")
    require(try_set<T>(data, 1, third), "set valid")
    same_items<T>(alias, [first, third, third, first], "set aliases and guards")
    require(try_fill_range<T>(data, 1, 2, second), "fill valid")
    same_items<T>(alias, [first, second, second, first], "fill guards")
    require(try_copy_range<T>(original, 0, data, 0, 4), "reset copy")
    require(not try_fill_range<T>(data, -1, 0, third), "fill rejects window")
    same_items<T>(alias, original, "rejected fill preserves alias")
    require(not try_fill_range<T>(data, 0, -1, third), "fill rejects window")
    same_items<T>(alias, original, "rejected fill preserves alias")
    require(not try_fill_range<T>(data, 5, 0, third), "fill rejects window")
    same_items<T>(alias, original, "rejected fill preserves alias")
    require(not try_fill_range<T>(data, 3, 2, third), "fill rejects window")
    same_items<T>(alias, original, "rejected fill preserves alias")
    require(not try_fill_range<T>(data, 2147483647, 2, third), "fill rejects window")
    same_items<T>(alias, original, "rejected fill preserves alias")
    require(not try_fill_range<T>(data, 1, 2147483647, third), "fill rejects window")
    same_items<T>(alias, original, "rejected fill preserves alias")
    require(not try_fill_range<T>(data, minimum, 1, third), "fill rejects window")
    same_items<T>(alias, original, "rejected fill preserves alias")
    require(not try_fill_range<T>(data, 0, minimum, third), "fill rejects window")
    same_items<T>(alias, original, "rejected fill preserves alias")
    require(try_fill_range<T>(data, 4, 0, third), "fill endpoint")
    require(try_fill_range<T>(data, 0, 0, third), "fill empty window")
    same_items<T>(alias, original, "zero fill preserves array")
    require(not try_copy_range<T>(original, -1, data, 0, 1), "copy rejects window")
    same_items<T>(alias, [first, second, third, first], "rejected copy preserves destination")
    same_items<T>(original, [first, second, third, first], "rejected copy preserves source")
    require(not try_copy_range<T>(original, 0, data, -1, 1), "copy rejects window")
    same_items<T>(alias, [first, second, third, first], "rejected copy preserves destination")
    same_items<T>(original, [first, second, third, first], "rejected copy preserves source")
    require(not try_copy_range<T>(original, 0, data, 0, -1), "copy rejects window")
    same_items<T>(alias, [first, second, third, first], "rejected copy preserves destination")
    same_items<T>(original, [first, second, third, first], "rejected copy preserves source")
    require(not try_copy_range<T>(original, 5, data, 0, 0), "copy rejects window")
    same_items<T>(alias, [first, second, third, first], "rejected copy preserves destination")
    same_items<T>(original, [first, second, third, first], "rejected copy preserves source")
    require(not try_copy_range<T>(original, 0, data, 5, 0), "copy rejects window")
    same_items<T>(alias, [first, second, third, first], "rejected copy preserves destination")
    same_items<T>(original, [first, second, third, first], "rejected copy preserves source")
    require(not try_copy_range<T>(original, 3, data, 0, 2), "copy rejects window")
    same_items<T>(alias, [first, second, third, first], "rejected copy preserves destination")
    same_items<T>(original, [first, second, third, first], "rejected copy preserves source")
    require(not try_copy_range<T>(original, 0, data, 3, 2), "copy rejects window")
    same_items<T>(alias, [first, second, third, first], "rejected copy preserves destination")
    same_items<T>(original, [first, second, third, first], "rejected copy preserves source")
    require(not try_copy_range<T>(original, 2147483647, data, 0, 2), "copy rejects window")
    same_items<T>(alias, [first, second, third, first], "rejected copy preserves destination")
    same_items<T>(original, [first, second, third, first], "rejected copy preserves source")
    require(not try_copy_range<T>(original, 0, data, 2147483647, 2), "copy rejects window")
    same_items<T>(alias, [first, second, third, first], "rejected copy preserves destination")
    same_items<T>(original, [first, second, third, first], "rejected copy preserves source")
    require(not try_copy_range<T>(original, 1, data, 0, 2147483647), "copy rejects window")
    same_items<T>(alias, [first, second, third, first], "rejected copy preserves destination")
    same_items<T>(original, [first, second, third, first], "rejected copy preserves source")
    require(not try_copy_range<T>(original, 0, data, 1, 2147483647), "copy rejects window")
    same_items<T>(alias, [first, second, third, first], "rejected copy preserves destination")
    same_items<T>(original, [first, second, third, first], "rejected copy preserves source")
    require(not try_copy_range<T>(original, minimum, data, 0, 1), "copy rejects window")
    same_items<T>(alias, [first, second, third, first], "rejected copy preserves destination")
    same_items<T>(original, [first, second, third, first], "rejected copy preserves source")
    require(not try_copy_range<T>(original, 0, data, minimum, 1), "copy rejects window")
    same_items<T>(alias, [first, second, third, first], "rejected copy preserves destination")
    same_items<T>(original, [first, second, third, first], "rejected copy preserves source")
    require(not try_copy_range<T>(original, 0, data, 0, minimum), "copy rejects window")
    same_items<T>(alias, [first, second, third, first], "rejected copy preserves destination")
    same_items<T>(original, [first, second, third, first], "rejected copy preserves source")
    require(try_copy_range<T>(original, 4, data, 4, 0), "copy endpoint")
    same_items<T>(alias, original, "zero copy preserves array")
    require(try_copy_range<T>(data, 0, alias, 1, 3), "overlap right")
    same_items<T>(alias, [first, first, second, third], "right overlap snapshot")
    require(try_copy_range<T>(alias, 1, data, 0, 3), "overlap left")
    same_items<T>(data, [first, second, third, third], "left overlap snapshot")
    require(try_copy_range<T>(alias, 0, data, 0, 4), "identical window")
    same_items<T>(data, [first, second, third, third], "identical copy snapshot")
    let target: array<T> = [third, third, third, third]
    require(try_copy_range<T>(original, 1, target, 0, 3), "independent copy forward")
    same_items<T>(target, [second, third, first, third], "independent forward snapshot")
    require(try_copy_range<T>(original, 0, target, 1, 3), "independent copy backward")
    same_items<T>(target, [second, first, second, third], "independent backward snapshot")
    same_items<T>(original, [first, second, third, first], "copy leaves source")
    let short: array<T> = [third, third]
    require(not try_copy_range<T>(original, 0, short, 0, 3), "short destination rejects count")
    same_items<T>(short, [third, third], "short destination keeps writable prefix")
    require(try_copy_range<T>(original, 0, short, 0, 2), "short destination valid copy")
    same_items<T>(short, [first, second], "short destination snapshot")
    require(not try_copy_range<T>(short, 0, target, 0, 3), "short source rejects count")
    same_items<T>(target, [second, first, second, third], "short source leaves destination")
    same_items<T>(short, [first, second], "short source unchanged")
    require(try_copy_range<T>(short, 0, target, 1, 2), "short source valid copy")
    same_items<T>(target, [second, first, second, third], "short source valid snapshot")
    require(try_fill_range<T>(target, 0, 4, second), "fill whole array")
    same_items<T>(target, [second, second, second, second], "whole fill snapshot")
    let empty: array<T> = []
    require(try_get<T>(empty, 0).is_none(), "empty get")
    require(not try_set<T>(empty, 0, first), "empty set")
    require(try_fill_range<T>(empty, 0, 0, first), "empty fill")
    require(not try_fill_range<T>(empty, 0, 1, first), "empty fill rejects item")
    require(try_copy_range<T>(empty, 0, empty, 0, 0), "empty copy")
    require(try_copy_range<T>(empty, 0, data, 4, 0), "empty to endpoint")
    require(try_copy_range<T>(data, 4, empty, 0, 0), "endpoint to empty")
    require(not try_copy_range<T>(empty, 0, data, 0, 1), "empty source rejects item")
    require(not try_copy_range<T>(data, 0, empty, 0, 1), "empty destination rejects item")
    require(empty.len() == 0, "checked operations never grow")
    println(label)
end fn

fn main() -> i32
    check_kind<i32>(-7, 0, 2147483647, "checked i32")
    check_kind<i64>(-9000000000 as i64, 0 as i64, 9000000000 as i64, "checked i64")
    check_kind<u8>(0 as u8, 128 as u8, 255 as u8, "checked u8")
    check_kind<bool>(true, false, true, "checked bool")
    check_kind<f64>(-0.5, 0.25, 1.5, "checked f64")
    check_kind<text>("", "middle" + "-value", "last", "checked text")
    return 0
end fn
