import nil.std.math
import nil.std.core

fn require(ok: bool, message: text)
    if not ok then panic(message) end if
end fn

fn near(actual: f64, expected: f64)
    require(is_finite(actual), "finite result")
    require(abs(actual - expected) <= 0.000000000001, "independent coordinate oracle")
end fn

fn check_scale(scale: f64)
    let pair = vec2.new(-3.0 * scale, 4.0 * scale)
    let triple = vec3.new(2.0 * scale, -3.0 * scale, 6.0 * scale)
    let pair_alias = pair
    let triple_alias = triple
    require(pair.is_finite() and triple.is_finite(), "finite input classification")
    near(pair.length() / scale, 5.0)
    near(triple.length() / scale, 7.0)
    near(pair.distance(vec2.zero()) / scale, 5.0)
    near(triple.distance(vec3.zero()) / scale, 7.0)
    near(hypot2(pair.x, pair.y) / scale, 5.0)
    near(hypot3(triple.x, triple.y, triple.z) / scale, 7.0)
    let pair_result = pair.try_normalize()
    let triple_result = triple.try_normalize()
    require(pair_result.is_some() and triple_result.is_some(), "finite nonzero directions")
    let pair_unit = pair_result.unwrap()
    let triple_unit = triple_result.unwrap()
    near(pair_unit.x, -0.6)
    near(pair_unit.y, 0.8)
    near(triple_unit.x, 2.0 / 7.0)
    near(triple_unit.y, -3.0 / 7.0)
    near(triple_unit.z, 6.0 / 7.0)
    near(pair.normalize().x, -0.6)
    near(pair.normalize().y, 0.8)
    near(triple.normalize().x, 2.0 / 7.0)
    near(triple.normalize().y, -3.0 / 7.0)
    near(triple.normalize().z, 6.0 / 7.0)
    require(pair_alias.x == -3.0 * scale and pair_alias.y == 4.0 * scale, "vec2 input preserved")
    require(triple_alias.x == 2.0 * scale and triple_alias.y == -3.0 * scale and triple_alias.z == 6.0 * scale, "vec3 input preserved")
end fn

fn main() -> i32
    check_scale(1.0)
    check_scale(pow(10.0, 200.0))
    check_scale(pow(10.0, -200.0))
    check_scale(pow(2.0, -1022.0))
    check_scale(pow(2.0, -1074.0))
    println("ordinary, extreme and subnormal norms")

    let large = pow(2.0, 1022.0) * 1.5
    let overflowing_pair = vec2.new(2.0 * large, -2.0 * large)
    let overflowing_triple = vec3.new(2.0 * large, -2.0 * large, large)
    require(overflowing_pair.is_finite() and overflowing_triple.is_finite(), "finite overflow inputs")
    require(not is_finite(overflowing_pair.length()) and not is_finite(overflowing_triple.length()), "true length overflow")
    let pair = overflowing_pair.try_normalize().unwrap()
    let triple = overflowing_triple.try_normalize().unwrap()
    near(pair.x, 0.7071067811865475)
    near(pair.y, -0.7071067811865475)
    near(triple.x, 2.0 / 3.0)
    near(triple.y, -2.0 / 3.0)
    near(triple.z, 1.0 / 3.0)
    let tiny = pow(2.0, -1074.0)
    let mixed = vec3.new(-tiny, large, 0.0).try_normalize().unwrap()
    near(mixed.x, 0.0)
    near(mixed.y, 1.0)
    near(mixed.z, 0.0)
    near(vec2.new(0.0, -tiny).try_normalize().unwrap().y, -1.0)
    near(vec3.new(0.0, 0.0, -tiny).try_normalize().unwrap().z, -1.0)
    println("normalization independent of length overflow")

    let zero_pair = vec2.new(-0.0, 0.0)
    let zero_triple = vec3.new(0.0, -0.0, -0.0)
    require(is_finite(-0.0) and zero_pair.is_finite() and zero_triple.is_finite(), "zero is finite")
    require(zero_pair.try_normalize().is_none() and zero_triple.try_normalize().is_none(), "zero has no direction")
    require(hypot2(-0.0, 0.0) == 0.0 and hypot3(-0.0, -0.0, 0.0) == 0.0, "zero norms")
    require(atan2(zero_pair.normalize().x, -1.0) < 0.0, "vec2 signed zero retained")
    require(atan2(zero_triple.normalize().z, -1.0) < 0.0, "vec3 signed zero retained")
    let nan = sqrt(-1.0)
    let infinity = exp(1000.0)
    require(not is_finite(nan) and not is_finite(infinity) and not is_finite(-infinity), "nonfinite scalars")
    let bad_pair = vec2.new(nan, infinity)
    let bad_triple = vec3.new(-infinity, 2.0, nan)
    require(not bad_pair.is_finite() and not bad_triple.is_finite(), "nonfinite vectors")
    require(bad_pair.try_normalize().is_none() and bad_triple.try_normalize().is_none(), "nonfinite direction rejected")
    require(vec2.new(0.0, infinity).try_normalize().is_none(), "infinity in second component")
    require(vec3.new(0.0, nan, 0.0).try_normalize().is_none(), "NaN in middle component")
    require(vec3.new(0.0, 0.0, -infinity).try_normalize().is_none(), "infinity in third component")
    let retained_pair = bad_pair.normalize()
    let retained_triple = bad_triple.normalize()
    require(retained_pair.x != retained_pair.x and retained_pair.y == infinity, "vec2 invalid input retained")
    require(retained_triple.x == -infinity and retained_triple.y == 2.0 and retained_triple.z != retained_triple.z, "vec3 invalid input retained")
    require(hypot2(-infinity, 1.0) == infinity and hypot3(1.0, 2.0, -infinity) == infinity, "positive infinite norms")
    let nan_pair_length = hypot2(infinity, nan)
    let nan_triple_length = hypot3(nan, infinity, 1.0)
    require(nan_pair_length != nan_pair_length and nan_triple_length != nan_triple_length, "NaN norm propagation")
    println("zero and nonfinite contracts")
    return 0
end fn
