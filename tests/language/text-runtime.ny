import ny.lang.text.string_utils

fn main() -> i32
    println(ny::lang::text::trim("  Hello Ny  "))
    println(ny::lang::text::to_upper("Ny-42"))
    println(ny::lang::text::to_lower("Ny-42"))
    println(ny::lang::text::replace("one fish two fish", "fish", "byte"))
    println(ny::lang::text::replace_first("aaaa", "aa", "b"))
    println(ny::lang::text::index_of("banana", "ana"))
    println(ny::lang::text::last_index_of("banana", "ana"))
    println(ny::lang::text::starts_with("nilcompiler", "nil"))
    println(ny::lang::text::ends_with("frame.data", ".data"))
    println(ny::lang::text::repeat("ab", 3))
    println(ny::lang::text::reverse("codec"))
    println(ny::lang::text::substring("framebuffer", 5, 6))
    println(ny::lang::text::pad_left_char("7", 3, "0"))
    println(ny::lang::text::center("Ny", 6))
    println(ny::lang::text::is_numeric("12345"))
    println(ny::lang::text::is_alpha("Ny"))
    println(ny::lang::text::is_alphanumeric("Ny42"))

    let pieces = ny::lang::text::split("alpha,beta,gamma", ",")
    println(pieces.length())
    println(pieces.get(0).unwrap())
    println(pieces.get(1).unwrap())
    println(pieces.get(2).unwrap())
    println(ny::lang::text::join(pieces, "|"))

    println(ny::lang::text::capitalize("nY"))
    println(ny::lang::text::title_case("hELLo_nY-world"))
    println("[" + ny::lang::text::trim_start("  left  ") + "]")
    println("[" + ny::lang::text::trim_end("  right  ") + "]")
    println(ny::lang::text::trim_chars("..Ny..", "."))

    println(ny::lang::text::contains("framebuffer", "buffer"))
    println(ny::lang::text::contains("framebuffer", "codec"))
    println(ny::lang::text::index_of_from("banana", "ana", 2))
    println(ny::lang::text::last_index_of_from("banana", "ana", 2))
    println(ny::lang::text::index_of_from("abc", "", 99))
    println(ny::lang::text::index_of_from("abc", "", -2))
    println(ny::lang::text::last_index_of("", ""))
    println(ny::lang::text::count("aaaa", "aa"))
    println(ny::lang::text::replace("unchanged", "missing", "x"))

    let characters = ny::lang::text::split("Ny", "")
    let limited = ny::lang::text::split_n("a,b,c", ",", 2)
    let words = ny::lang::text::split_whitespace("  alpha\tbeta\n gamma  ")
    let control_words = ny::lang::text::split_whitespace("alpha\fbeta\vgamma")
    let lines = ny::lang::text::split_lines("one\ntwo\n")
    let portable_lines = ny::lang::text::split_lines("one\r\ntwo\rthree")
    println(ny::lang::text::join(characters, "/"))
    println(ny::lang::text::join(limited, "|"))
    println(ny::lang::text::join(words, "|"))
    println(ny::lang::text::join(control_words, "|"))
    println("[" + ny::lang::text::join(lines, "|") + "]")
    println(ny::lang::text::join(portable_lines, "|"))

    println("[" + ny::lang::text::pad_left("Ny", 4) + "]")
    println("[" + ny::lang::text::pad_right("Ny", 4) + "]")
    println(ny::lang::text::pad_right_char("7", 3, "0"))
    println("[" + ny::lang::text::pad_left_char("7", 3, "") + "]")
    println(ny::lang::text::is_empty(ny::lang::text::repeat("x", -2)))
    println("[" + ny::lang::text::substring("codec", 20, 2) + "]")
    println(ny::lang::text::char_at("codec", 2))
    println("[" + ny::lang::text::char_at("codec", -1) + "]")
    println(ny::lang::text::length("Ny"))
    println(ny::lang::text::remove_prefix("nilcompiler", "nil"))
    println(ny::lang::text::remove_suffix("frame.nil", ".nil"))
    println(ny::lang::text::truncate("framebuffer", 7, "..."))
    println(ny::lang::text::truncate("framebuffer", 2, "..."))
    println("[" + ny::lang::text::truncate("framebuffer", -1, "...") + "]")

    println(ny::lang::text::is_empty(""))
    println(ny::lang::text::is_whitespace(" \t\n"))
    println(ny::lang::text::is_whitespace(""))
    println(ny::lang::text::is_blank(""))
    println(ny::lang::text::is_numeric("12a"))
    println(ny::lang::text::is_alpha("Ny2"))
    println(ny::lang::text::is_alphanumeric("Ny-2"))
    println(ny::lang::text::is_lower("ny-42"))
    println(ny::lang::text::is_lower("Ny"))
    println(ny::lang::text::is_upper("NY-42"))
    println(ny::lang::text::is_upper("Ny"))
    println(ny::lang::text::int_to_string(-42))
    println(ny::lang::text::int_to_string_i64(9000000000 as i64))
    return 0
end fn
