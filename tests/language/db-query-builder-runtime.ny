import ny.lang.db

fn main() -> i32
    let selected: sql_query = select_query.from("users")
        .columns(["users.id", "users.name"])
        .left_join("teams", "teams.id = users.team_id")
        .where_eq("users.active", "true")
        .where_null("users.deleted_at")
        .where_like("users.name", "%son%")
        .order_by("users.name", true)
        .limit(25)
        .offset(5)
        .build()
    println(selected.sql)
    println(selected.parameter_count())
    println(selected.parameter(0).unwrap())
    println(selected.parameter(1).unwrap())

    let alternate: sql_query = select_query.from("events")
        .column("id")
        .join("streams", "streams.id = events.stream_id")
        .where_ne("kind", "debug")
        .where_gt("sequence", "10")
        .where_lt("sequence", "20")
        .where_not_null("payload")
        .order_by("id", false)
        .build()
    println(alternate.sql)
    println(alternate.parameter_count())
    println(alternate.parameter(0).unwrap())
    println(alternate.parameter(1).unwrap())
    println(alternate.parameter(2).unwrap())
    println(alternate.parameter(3).is_none())
    println(select_query.from("health").to_sql())

    let inserted: sql_query = insert_query.into("users")
        .value("name", "Ada")
        .value("active", "true")
        .build()
    println(inserted.sql)
    println(inserted.parameter(0).unwrap())
    println(inserted.parameter(1).unwrap())

    let default_insert: sql_query = insert_query.into("audit_log").build()
    println(default_insert.sql)

    let updated: sql_query = update_query.table("users")
        .set("name", "Grace")
        .set("active", "false")
        .where_eq("id", "42")
        .build()
    println(updated.sql)
    println(updated.parameter_count())
    println(updated.parameter(2).unwrap())

    let deleted: sql_query = delete_query.from("sessions")
        .where_eq("user_id", "42")
        .where_eq("state", "expired")
        .build()
    println(deleted.sql)
    println(deleted.parameter_count())
    println(deleted.parameter(1).unwrap())
    return 0
end fn
