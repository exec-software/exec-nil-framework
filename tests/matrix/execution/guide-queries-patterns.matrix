!!! Verbatim constructs from MATRIX-GUIDE.md sections 20 and 21, which need the
!!! standard library: queries read nil.std.collections terminals and patterns
!!! are compiled by nil.std.text.
book tour.guide-queries

read everything from nil.std.text
read everything from nil.std.collections

dollar-amount begin pattern
    capture amount matching one or more ascii digits
    require next to match literal " USD"
end pattern

main returns number begin paragraph
    value scores as array of number is [41, 7, 19, 55]
    value top is collect begin query
        from each score in scores
        where score is greater than 10
        order by score descending
        take 2
        give score times 2
    end query
    say the length of top
    say top at 0
    say top at 1

    value plain is collect begin query
        from each score in scores
        give score
    end query
    say query-count with items being plain
    say query-any with items being top
    say (query-first with items being top).unwrap with nothing
    say (query-last with items being top).unwrap with nothing
    say (query-single with items being top).is-error with nothing

    value compiled is (compile_pattern with source being dollar-amount).unwrap with nothing
    value found is ((first_match with pattern being compiled,
                     input being "price: 12 USD").unwrap with nothing).unwrap with nothing
    say (capture_named with found being found, name being "amount").unwrap with nothing

    value conventional is (compile_pattern with source being "(?<amount>[0-9]+)(?= USD)").unwrap with nothing
    value same is ((first_match with pattern being conventional,
                    input being "price: 12 USD").unwrap with nothing).unwrap with nothing
    say (capture_named with found being same, name being "amount").unwrap with nothing
    give 0
end paragraph
