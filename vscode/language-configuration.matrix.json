{
  "comments": {
    "lineComment": "!!!"
  },
  "brackets": [
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "`",
      "close": "`",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "`",
      "`"
    ]
  ],
  "wordPattern": "[A-Za-z_\\u0080-\\uFFFF][A-Za-z0-9_\\u0080-\\uFFFF]*(?:-[A-Za-z\\u0080-\\uFFFF][A-Za-z0-9_\\u0080-\\uFFFF]*)*|-?0[xX][0-9A-Fa-f]+|-?[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?",
  "indentationRules": {
    "increaseIndentPattern": "^[ \\t]*(?:(?:[^!\"`]|\"[^\"\\r\\n]*\"|`[^`\\r\\n]*`)*(?<![A-Za-z0-9_\\u0080-\\uFFFF-])(?:[bB][eE][gG][iI][nN])(?![A-Za-z0-9_\\u0080-\\uFFFF-])[ \\t]+(?:[pP][aA][rR][aA][gG][rR][aA][pP][hH]|[rR][eE][cC][oO][rR][dD]|[cC][hH][oO][iI][cC][eE]|[cC][lL][aA][sS][sS]|[cC][oO][nN][tT][rR][aA][cC][tT]|[iI][mM][pP][lL][eE][mM][eE][nN][tT][aA][tT][iI][oO][nN]|[eE][xX][tT][eE][nN][sS][iI][oO][nN]|[tT][eE][sS][tT]|[tT][eE][xX][tT])(?![A-Za-z0-9_\\u0080-\\uFFFF-])|(?:(?:[wW][hH][eE][nN]|[pP][rR][oO][vV][iI][dD][eE][dD])(?![A-Za-z0-9_\\u0080-\\uFFFF-]))[ \\t]+(?:[^!\"`]|\"[^\"\\r\\n]*\"|`[^`\\r\\n]*`)*(?<![A-Za-z0-9_\\u0080-\\uFFFF-])(?:[tT][hH][eE][nN])(?![A-Za-z0-9_\\u0080-\\uFFFF-])|(?:(?:[oO][tT][hH][eE][rR][wW][iI][sS][eE]|[cC][aA][uU][gG][hH][tT])(?![A-Za-z0-9_\\u0080-\\uFFFF-]))(?:[ \\t]+(?:[^!\"`]|\"[^\"\\r\\n]*\"|`[^`\\r\\n]*`)*)?|(?:[aA][tT][tT][eE][mM][pP][tT]|[aA][lL][wW][aA][yY][sS])(?![A-Za-z0-9_\\u0080-\\uFFFF-])|(?:[cC][oO][nN][sS][iI][dD][eE][rR]|[rR][eE][pP][eE][aA][tT])(?![A-Za-z0-9_\\u0080-\\uFFFF-])[ \\t]+(?:[^!\"`]|\"[^\"\\r\\n]*\"|`[^`\\r\\n]*`)*)[ \\t]*(?:!!!.*)?$",
    "decreaseIndentPattern": "^[ \\t]*(?:(?:[eE][nN][dD]|[oO][tT][hH][eE][rR][wW][iI][sS][eE]|[cC][aA][uU][gG][hH][tT]|[aA][lL][wW][aA][yY][sS])(?![A-Za-z0-9_\\u0080-\\uFFFF-]))"
  },
  "folding": {
    "markers": {
      "start": "^[ \\t]*(?:(?:[^!\"`]|\"[^\"\\r\\n]*\"|`[^`\\r\\n]*`)*(?<![A-Za-z0-9_\\u0080-\\uFFFF-])(?:[bB][eE][gG][iI][nN])(?![A-Za-z0-9_\\u0080-\\uFFFF-])[ \\t]+(?:[pP][aA][rR][aA][gG][rR][aA][pP][hH]|[rR][eE][cC][oO][rR][dD]|[cC][hH][oO][iI][cC][eE]|[cC][lL][aA][sS][sS]|[cC][oO][nN][tT][rR][aA][cC][tT]|[iI][mM][pP][lL][eE][mM][eE][nN][tT][aA][tT][iI][oO][nN]|[eE][xX][tT][eE][nN][sS][iI][oO][nN]|[tT][eE][sS][tT]|[tT][eE][xX][tT])(?![A-Za-z0-9_\\u0080-\\uFFFF-])|(?:[aA][tT][tT][eE][mM][pP][tT])(?![A-Za-z0-9_\\u0080-\\uFFFF-])|(?:[cC][oO][nN][sS][iI][dD][eE][rR]|[rR][eE][pP][eE][aA][tT])(?![A-Za-z0-9_\\u0080-\\uFFFF-])[ \\t]+(?:[^!\"`]|\"[^\"\\r\\n]*\"|`[^`\\r\\n]*`)*)[ \\t]*(?:!!!.*)?$",
      "end": "^[ \\t]*(?:[eE][nN][dD])(?![A-Za-z0-9_\\u0080-\\uFFFF-])"
    }
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*!!!.*$",
      "action": {
        "indentAction": "none",
        "appendText": "!!! "
      }
    }
  ]
}
